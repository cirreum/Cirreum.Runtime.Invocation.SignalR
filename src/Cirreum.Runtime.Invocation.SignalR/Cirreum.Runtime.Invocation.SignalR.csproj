<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Cirreum.Runtime</RootNamespace>
		<Description>Runtime Extensions package for the Cirreum SignalR invocation source — app-facing AddSignalRInvocation() / AddSignalR&lt;THub&gt;() / MapSignalRInvocation() extensions that wire SignalR Hubs into the unified IInvocationContext seam from configuration.</Description>
		<PackageTags>cirreum;runtime;invocation;signalr;hub;providers</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Cirreum.Runtime.InvocationProvider" Version="1.1.0" />
		<PackageReference Include="Cirreum.Invocation.SignalR" Version="1.0.2" />
	</ItemGroup>

</Project>
